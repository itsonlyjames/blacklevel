<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.itsonlyjames.blacklevel"
    android:versionCode="4"
    android:versionName="1.2.1">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="31" />

    <!-- device names for HDMI-CEC inputs come from the TV's own API on 127.0.0.1 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- updates itself from GitHub Releases (Customise → Updates); the TV asks once before allowing it -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: we only need launchable TV apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Blacklevel"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:theme="@style/Home"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- lets Home see what's playing (Customise → Screen → Now playing); enabled over adb, see README -->
        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:label="Blacklevel now playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
